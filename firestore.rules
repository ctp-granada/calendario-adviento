rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isTeacher() {
      return isVerifiedUser()
        && 'email' in request.auth.token
        && request.auth.token.email.lower() in ['ctp@go.ugr.es'];
    }

    // Puntuación máxima posible: 23 días x 150 + día 24 x 300 = 3750
    function validScore(d) {
      return d.puntos is int && d.puntos >= 0 && d.puntos <= 3750
          && d.puertas is int && d.puertas >= 0 && d.puertas <= 24;
    }

    function isValidAlumnoCreate(d) {
      return d.keys().hasAll([
          'nombre', 'email', 'grupo', 'respuestas',
          'puntos', 'aciertos', 'puertas', 'racha', 'mejorRacha',
          'creado', 'actualizado'
        ])
        && d.keys().hasOnly([
          'nombre', 'email', 'grupo', 'respuestas',
          'puntos', 'aciertos', 'puertas', 'racha', 'mejorRacha',
          'creado', 'actualizado'
        ])
        && d.nombre is string && d.nombre.size() <= 120
        && d.email is string && d.email.size() <= 160
        && d.grupo is string && d.grupo.size() <= 60
        && d.respuestas is map && d.respuestas.size() == 0
        && d.puntos is int && d.puntos == 0
        && d.aciertos is int && d.aciertos == 0
        && d.puertas is int && d.puertas == 0
        && d.racha is int && d.racha == 0
        && d.mejorRacha is int && d.mejorRacha == 0
        && d.creado == request.time
        && d.actualizado == request.time
        && (!('email' in request.auth.token)
            || d.email == request.auth.token.email.lower());
    }

    function isValidAlumnoUpdate(d) {
      return d.keys().hasAll([
          'nombre', 'email', 'grupo', 'respuestas',
          'puntos', 'aciertos', 'puertas', 'racha', 'mejorRacha',
          'creado', 'actualizado'
        ])
        && d.keys().hasOnly([
          'nombre', 'email', 'grupo', 'respuestas',
          'puntos', 'aciertos', 'puertas', 'racha', 'mejorRacha',
          'creado', 'actualizado'
        ])
        && d.nombre is string && d.nombre.size() <= 120
        && d.email is string && d.email.size() <= 160
        && d.grupo is string && d.grupo.size() <= 60
        && d.respuestas is map && d.respuestas.size() <= 24
        && validScore(d)
        && d.aciertos is int && d.aciertos >= 0 && d.aciertos <= 24
        && d.racha is int && d.racha >= 0 && d.racha <= 24
        && d.mejorRacha is int && d.mejorRacha >= 0 && d.mejorRacha <= 24
        && d.actualizado == request.time;
    }

    function isValidRanking(d) {
      return d.keys().hasAll(['alias', 'grupo', 'puntos', 'puertas', 'actualizado'])
        && d.keys().hasOnly(['alias', 'grupo', 'puntos', 'puertas', 'actualizado'])
        && d.alias is string && d.alias.size() > 0 && d.alias.size() <= 80
        && d.grupo is string && d.grupo.size() <= 60
        && validScore(d)
        && d.actualizado == request.time;
    }

    match /alumnos/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isTeacher());
      allow list: if isTeacher();

      allow create: if isVerifiedUser()
        && isValidId(uid)
        && request.auth.uid == uid
        && isValidAlumnoCreate(incoming());

      allow update: if isVerifiedUser()
        && isValidId(uid)
        && request.auth.uid == uid
        && isValidAlumnoUpdate(incoming())
        && incoming().creado == existing().creado
        && incoming().email == existing().email
        && incoming().nombre == existing().nombre
        && (
          (
            incoming().respuestas.keys().hasAll(existing().respuestas.keys())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'respuestas', 'puntos', 'aciertos', 'puertas', 'racha', 'mejorRacha', 'actualizado'
            ])
          )
          ||
          (
            existing().grupo == ''
            && incoming().diff(existing()).affectedKeys().hasOnly(['grupo', 'actualizado'])
          )
        );

      allow delete: if isTeacher() && isValidId(uid);
    }

    match /ranking/{uid} {
      allow get: if isSignedIn() && isValidId(uid);
      allow list: if isSignedIn() && resource.data.puntos >= 0;

      allow create: if isVerifiedUser()
        && isValidId(uid)
        && request.auth.uid == uid
        && isValidRanking(incoming());

      allow update: if isVerifiedUser()
        && isValidId(uid)
        && request.auth.uid == uid
        && isValidRanking(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'alias', 'grupo', 'puntos', 'puertas', 'actualizado'
        ]);

      allow delete: if isTeacher() && isValidId(uid);
    }

    function isValidStatsCreate(d) {
      return d.keys().hasAll(['visitas', 'actualizado'])
        && d.keys().hasOnly(['visitas', 'actualizado'])
        && d.visitas is int && d.visitas == 1
        && d.actualizado == request.time;
    }

    function isValidStatsUpdate(d) {
      return d.keys().hasAll(['visitas', 'actualizado'])
        && d.keys().hasOnly(['visitas', 'actualizado'])
        && d.visitas is int && d.visitas == existing().visitas + 1
        && d.actualizado == request.time;
    }

    function isValidValoracion(d) {
      return d.keys().hasAll(['puntuacion', 'actualizado'])
        && d.keys().hasOnly(['puntuacion', 'actualizado'])
        && d.puntuacion is int && d.puntuacion >= 0 && d.puntuacion <= 5
        && d.actualizado == request.time;
    }

    match /estadisticas/{statId} {
      allow get: if isSignedIn() && isValidId(statId) && statId == 'general';
      allow create: if isVerifiedUser()
        && isValidId(statId)
        && statId == 'general'
        && isValidStatsCreate(incoming());
      allow update: if isVerifiedUser()
        && isValidId(statId)
        && statId == 'general'
        && isValidStatsUpdate(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['visitas', 'actualizado']);
      allow delete: if false;
    }

    match /valoraciones/{uid} {
      allow get: if isSignedIn() && isValidId(uid);
      allow list: if isSignedIn() && resource.data.puntuacion >= 0 && resource.data.puntuacion <= 5;
      allow create: if isVerifiedUser()
        && isValidId(uid)
        && request.auth.uid == uid
        && isValidValoracion(incoming());
      allow update: if isVerifiedUser()
        && isValidId(uid)
        && request.auth.uid == uid
        && isValidValoracion(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['puntuacion', 'actualizado']);
      allow delete: if isTeacher() && isValidId(uid);
    }
  }
}
